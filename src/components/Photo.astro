---
import type { Photo } from "../lib/content";
interface Props {
  photo: Photo;
  eager?: boolean;
  sizes?: string;
}
const {
  photo,
  eager = false,
  sizes = "(max-width: 700px) 90vw, (max-width: 1447px) 76vw, 1100px",
} = Astro.props;
---

<img
  class="artwork"
  src={photo.src}
  srcset={photo.srcset}
  sizes={sizes}
  width={photo.width}
  height={photo.height}
  alt={photo.alt}
  data-alt-en={photo.altKo ? photo.alt : undefined}
  data-alt-ko={photo.altKo}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : "auto"}
  decoding="async"
  draggable="false"
/>
