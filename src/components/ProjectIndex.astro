---
import type { Project } from "../lib/content";
import Photo from "./Photo.astro";
import interactive from "../content/then-and-then.json";
interface Props {
  projects: Project[];
  showChapters?: boolean;
  showInteractive?: boolean;
}
const { projects, showChapters = true, showInteractive = false } = Astro.props;
const series = [...new Set(projects.map((project) => project.series))];
const entries = series.map((name) => {
  const members = projects.filter((project) => project.series === name);
  const representative = members.at(-1)!;
  return {
    name,
    members,
    representative,
    href:
      name === "OUR TIME"
        ? "/work/our-time/"
        : "/work/" + representative.slug + "/",
  };
});
---

<div class="project-index">
  {entries.map(({ name, members, representative, href }, index) => (
    <section
      class="project-index-card"
      id={"series-" + name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}
    >
      <h2>
        <a href={href}>{name}</a>
      </h2>
      <a class="project-index-image" href={href}>
        <Photo
          photo={representative.photos.find(
            (photo) => photo.name === representative.hero,
          )!}
          eager={index === 0}
          sizes="(max-width: 700px) 90vw, 42vw"
        />
      </a>
      {showChapters && name === "OUR TIME" && (
        <nav
          class="project-chapters"
          aria-label="OUR TIME chapters"
          data-aria-en="OUR TIME chapters"
          data-aria-ko="OUR TIME 시즌"
        >
          {members.map((project) => (
            <a href={"/work/" + project.slug + "/"}>{project.chapter}</a>
          ))}
        </nav>
      )}
    </section>
  ))}
  {showInteractive && (
    <section class="project-index-card" id="series-then-and-then">
      <h2>
        <a href="/work/then-and-then/">{interactive.title}</a>
      </h2>
      <a class="project-index-image" href="/work/then-and-then/">
        <img
          class="artwork"
          src={interactive.image}
          width={interactive.imageWidth}
          height={interactive.imageHeight}
          alt={interactive.imageAlt.en}
          data-alt-en={interactive.imageAlt.en}
          data-alt-ko={interactive.imageAlt.ko}
          loading="lazy"
          decoding="async"
          draggable="false"
        />
      </a>
      <p class="interactive-kind">
        <span data-lang="en">INTERACTIVE PHOTOGRAPHIC ARTWORK</span>
        <span data-lang="ko" lang="ko">
          인터랙티브 사진 작품
        </span>
      </p>
    </section>
  )}
</div>
