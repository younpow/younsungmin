---
import Layout from "../layouts/Layout.astro";
import about from "../content/about.json";
interface Entry {
  year: string;
  en: string;
  ko: string;
  href?: string;
}
interface CV {
  title: { en: string; ko: string };
  entries: Entry[];
}
const cv = about.cv as CV[];
---

<Layout
  title="About | YOUN SUNGMIN"
  description="Biography and selected photographic activity and artist books by Youn Sungmin."
  image="/media/home/ourtime_2026-03-08_01.jpg"
>
  <article class="text-page">
    <h1>ABOUT</h1>
    <div class="prose">
      <p data-lang="en">{about.biography.en}</p>
      <p data-lang="ko" lang="ko">
        {about.biography.ko}
      </p>
    </div>
    {cv.some((group) => group.entries.length > 0) && (
      <section class="cv">
        <h2>
          <span data-lang="en">Selected activity & publications</span>
          <span data-lang="ko" lang="ko">
            주요 활동 및 출판
          </span>
        </h2>
        {cv
          .filter((group) => group.entries.length > 0)
          .map((group) => (
            <section>
              <h3>
                <span data-lang="en">{group.title.en}</span>
                <span data-lang="ko" lang="ko">
                  {group.title.ko}
                </span>
              </h3>
              <dl>
                {group.entries.map((entry) => (
                  <>
                    <dt>{entry.year}</dt>
                    <dd>
                      {entry.href ? (
                        <a href={entry.href}>
                          <span data-lang="en">{entry.en}</span>
                          <span data-lang="ko" lang="ko">
                            {entry.ko}
                          </span>
                        </a>
                      ) : (
                        <>
                          <span data-lang="en">{entry.en}</span>
                          <span data-lang="ko" lang="ko">
                            {entry.ko}
                          </span>
                        </>
                      )}
                    </dd>
                  </>
                ))}
              </dl>
            </section>
          ))}
      </section>
    )}
  </article>
</Layout>
