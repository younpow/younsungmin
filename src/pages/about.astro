---
import Layout from "../layouts/Layout.astro";
import about from "../content/about.json";
interface Entry {
  year: string;
  en: string;
  ko: string;
  href?: string;
}
interface CV {
  title: { en: string; ko: string };
  entries: Entry[];
}
const cv = about.cv as CV[];
const isExternalHref = (href: string) => href.startsWith("https://");
---

<Layout
  title="About | YOUN SUNGMIN"
  description="Biography of South Korean photographer Youn Sungmin, whose long-term photographic practice explores time, distance, growth, memory, and traces in everyday spaces."
  image="/media/home/ourtime_2026-03-08_01.jpg"
>
  <article class="text-page">
    <h1>ABOUT</h1>
    <div class="prose">
      <div data-lang="en" lang="en">
        {about.biography.en.split(/\n\s*\n/).map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div data-lang="ko" lang="ko">
        {about.biography.ko.split(/\n\s*\n/).map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
    {cv.some((group) => group.entries.length > 0) && (
      <section class="cv">
        <h2>
          <span data-lang="en">Selected activity & publications</span>
          <span data-lang="ko" lang="ko">
            주요 활동 및 출판
          </span>
        </h2>
        {cv
          .filter((group) => group.entries.length > 0)
          .map((group) => (
            <section>
              <h3>
                <span data-lang="en">{group.title.en}</span>
                <span data-lang="ko" lang="ko">
                  {group.title.ko}
                </span>
              </h3>
              <dl>
                {group.entries.map((entry) => (
                  <>
                    <dt>{entry.year}</dt>
                    <dd>
                      {entry.href ? (
                        <a
                          href={entry.href}
                          target={
                            isExternalHref(entry.href) ? "_blank" : undefined
                          }
                          rel={
                            isExternalHref(entry.href)
                              ? "noopener noreferrer"
                              : undefined
                          }
                        >
                          <span data-lang="en">{entry.en}</span>
                          <span data-lang="ko" lang="ko">
                            {entry.ko}
                          </span>
                          {isExternalHref(entry.href) && (
                            <span aria-hidden="true"> ↗</span>
                          )}
                        </a>
                      ) : (
                        <>
                          <span data-lang="en">{entry.en}</span>
                          <span data-lang="ko" lang="ko">
                            {entry.ko}
                          </span>
                        </>
                      )}
                    </dd>
                  </>
                ))}
              </dl>
            </section>
          ))}
      </section>
    )}
    <p class="about-writing">
      <a
        href="https://brunch.co.kr/@nabodado"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-lang="en">Writing on Brunch</span>
        <span data-lang="ko" lang="ko">
          브런치에서 글 읽기
        </span>
        <span aria-hidden="true"> ↗</span>
      </a>
    </p>
  </article>
</Layout>
