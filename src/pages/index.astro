---
import Layout from "../layouts/Layout.astro";
import Photo from "../components/Photo.astro";
import ProjectIndex from "../components/ProjectIndex.astro";
import { getProjects } from "../lib/content";
import site from "../config/site.json";
const projects = await getProjects();
const hero = projects.find((p) => p.slug === site.heroProject);
const heroHref = hero ? "/work/" + hero.slug.split("/")[0] + "/" : "/work/";
const photo = hero
  ? site.heroPhoto || hero.photos.find((p) => p.name === site.heroImage)
  : undefined;
if (hero && !photo) throw new Error("Check heroImage in src/config/site.json");
---

<Layout image={photo?.src}>
  {hero && photo ? (
    <>
      <section class="home-hero">
        <a
          href={heroHref}
          data-aria-en={`View ${hero.series}`}
          data-aria-ko={`${hero.series} 프로젝트 보기`}
          aria-label={`View ${hero.series}`}
        >
          <Photo photo={photo} eager />
        </a>
        <div class="hero-note">
          <h1>
            <a href={heroHref}>{hero.title}</a>
          </h1>
          {!site.heroPhoto && <p>{hero.chapter}</p>}
          <a class="text-link" href="/work/">
            <span data-lang="en">VIEW ALL WORK</span>
            <span data-lang="ko" lang="ko">
              전체 작품 보기
            </span>
          </a>
        </div>
      </section>
      <section class="selected">
        <h2>
          <span data-lang="en">Selected Work</span>
          <span data-lang="ko" lang="ko">
            주요 작업
          </span>
        </h2>
        <ProjectIndex projects={projects} showChapters={false} />
      </section>
    </>
  ) : (
    <section class="text-page home-intro">
      <h1>YOUN SUNGMIN</h1>
      <p data-lang="en">Photographer based in South Korea.</p>
      <p data-lang="ko" lang="ko">
        한국을 기반으로 활동하는 사진작가.
      </p>
      <a class="text-link" href="/about/">
        ABOUT
      </a>
    </section>
  )}
</Layout>
