---
import Layout from "../layouts/Layout.astro";
import Photo from "../components/Photo.astro";
import WorkList from "../components/WorkList.astro";
import { getProjects } from "../lib/content";
import site from "../config/site.json";
const projects = await getProjects();
const hero = projects.find((p) => p.slug === site.heroProject);
const photo = hero ? (site.heroPhoto || hero.photos.find((p) => p.name === site.heroImage)) : undefined;
if (hero && !photo) throw new Error("Check heroImage in src/config/site.json");
---

<Layout image={photo?.src}>
  {hero && photo ? (
    <>
      <section class="home-hero">
        <a
          href={"/work/" + hero.slug + "/"}
          aria-label={"View " + hero.title + " — " + hero.chapter}
        >
          <Photo photo={photo} eager />
        </a>
        <div class="hero-note">
          <h1>{hero.title}</h1>
          {!site.heroPhoto && <p>{hero.chapter}</p>}
          <a class="text-link" href={"/work/" + hero.slug + "/"}>
            VIEW WORK
          </a>
        </div>
      </section>
      <section class="selected">
        <h2>Selected Work</h2>
        <WorkList projects={projects} />
      </section>
    </>
  ) : (
    <section class="text-page home-intro">
      <h1>YOUN SUNGMIN</h1>
      <p data-lang="en">Photographer based in South Korea.</p>
      <p data-lang="ko" lang="ko">
        한국을 기반으로 활동하는 사진작가.
      </p>
      <a class="text-link" href="/about/">
        ABOUT
      </a>
    </section>
  )}
</Layout>
