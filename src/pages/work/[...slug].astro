---
import Layout from "../../layouts/Layout.astro";
import Photo from "../../components/Photo.astro";
import { getProjects, type Project } from "../../lib/content";
export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
interface Props {
  project: Project;
}
const { project } = Astro.props;
const projects = await getProjects();
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[projectIndex + 1];
---

<Layout
  title={
    project.seoTitle ||
    project.title +
      (project.chapter ? " — " + project.chapter : "") +
      " | YOUN SUNGMIN"
  }
  description={project.seoDescription}
  image={project.photos.find((photo) => photo.name === project.hero)?.src}
>
  <article>
    <header class="project-intro">
      <h1>{project.title}</h1>
      {project.chapter && <p class="chapter">{project.chapter}</p>}
      {project.completed && (
        <p class="project-completion">
          <span data-lang="en">
            Completed project · {project.photos.length} photographs
          </span>
          <span data-lang="ko" lang="ko">
            완료된 프로젝트 · 사진 {project.photos.length}점
          </span>
        </p>
      )}
      {project.projectNote && (
        <div class="project-history">
          <p data-lang="en">{project.projectNote.en}</p>
          <p data-lang="ko" lang="ko">
            {project.projectNote.ko}
          </p>
        </div>
      )}
      {(project.statements.en.length > 0 ||
        project.statements.ko.length > 0) && (
        <div class="prose statement">
          {(["en", "ko"] as const).map((lang) => (
            <div data-lang={lang} lang={lang}>
              {project.statements[lang].map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          ))}
        </div>
      )}
      {(project.series === "OUR TIME" || project.hasBook) && (
        <nav
          class="project-actions"
          aria-label="Project links"
          data-aria-en="Project links"
          data-aria-ko="프로젝트 링크"
        >
          {project.series === "OUR TIME" && (
            <a
              class="text-link shared-statement-link"
              href="/work/our-time/#statement"
            >
              <span data-lang="en">OUR TIME ARTIST STATEMENT</span>
              <span data-lang="ko" lang="ko">
                OUR TIME 통합 작가노트
              </span>
            </a>
          )}
          {project.hasBook && (
            <a class="text-link" href={"/book/" + project.slug + "/"}>
              <span data-lang="en">VIEW BOOK</span>
              <span data-lang="ko" lang="ko">
                책 보기
              </span>
            </a>
          )}
        </nav>
      )}
    </header>
    <div class="sequence">
      {project.photos.map((photo, index) => (
        <button
          class="photo-open"
          data-photo={index}
          data-aria-en={"Open " + photo.alt}
          data-aria-ko={"사진 열기: " + (photo.altKo || photo.alt)}
          aria-label={"Open " + photo.alt}
        >
          <Photo photo={photo} eager={index === 0} />
        </button>
      ))}
    </div>
    <nav
      class="project-navigation"
      aria-label="Continue exploring"
      data-aria-en="Continue exploring"
      data-aria-ko="다른 작업 보기"
    >
      {nextProject && (
        <a class="text-link" href={"/work/" + nextProject.slug + "/"}>
          <span data-lang="en">
            NEXT · {nextProject.title}
            {nextProject.chapter ? " — " + nextProject.chapter : ""}
          </span>
          <span data-lang="ko" lang="ko">
            다음 작업 · {nextProject.title}
            {nextProject.chapter ? " — " + nextProject.chapter : ""}
          </span>
        </a>
      )}
      <a class="text-link" href="/contact/">
        <span data-lang="en">CONTACT</span>
        <span data-lang="ko" lang="ko">
          연락하기
        </span>
      </a>
      <a class="text-link back" href="/work/">
        <span data-lang="en">BACK TO WORK</span>
        <span data-lang="ko" lang="ko">
          작품 목록으로
        </span>
      </a>
    </nav>
  </article>
  <dialog
    class="lightbox"
    aria-label="Photograph viewer"
    data-aria-en="Photograph viewer"
    data-aria-ko="사진 보기"
  >
    <button
      class="lightbox-close"
      autofocus
      aria-label="Close photograph viewer"
      data-aria-en="Close photograph viewer"
      data-aria-ko="사진 보기 닫기"
    >
      <span data-lang="en">CLOSE</span>
      <span data-lang="ko" lang="ko">
        닫기
      </span>
    </button>
    <button
      class="lightbox-prev"
      aria-label="Previous photograph"
      data-aria-en="Previous photograph"
      data-aria-ko="이전 사진"
    >
      ←
    </button>
    <img draggable="false" alt="" />
    <button
      class="lightbox-next"
      aria-label="Next photograph"
      data-aria-en="Next photograph"
      data-aria-ko="다음 사진"
    >
      →
    </button>
    <p class="sr-only lightbox-status" aria-live="polite"></p>
  </dialog>
  <script>
    import "../../scripts/lightbox";
  </script>
</Layout>
