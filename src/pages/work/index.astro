---
import Layout from "../../layouts/Layout.astro";
import ProjectIndex from "../../components/ProjectIndex.astro";
import { getProjects } from "../../lib/content";
import interactive from "../../content/then-and-then.json";
const projects = await getProjects();
const series = [
  ...new Set(projects.map((project) => project.series)),
  interactive.title,
];
---

<Layout
  title="Work | YOUN SUNGMIN"
  description="Photographic projects and interactive artwork by Youn Sungmin: OUR TIME, DISTANCE, ORIGIN and THEN AND THEN."
  image="/media/home/ourtime_2026-03-08_01.jpg"
>
  <section class="work-page">
    <h1>WORK</h1>
    {series.length > 0 && (
      <nav
        class="work-index"
        aria-label="Project index"
        data-aria-en="Project index"
        data-aria-ko="프로젝트 바로가기"
      >
        {series.map((name) => (
          <a href={"#series-" + name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}>
            {name}
          </a>
        ))}
      </nav>
    )}
    <ProjectIndex projects={projects} showInteractive />
    {!projects.length && (
      <a class="text-link" href="/about/">
        ABOUT THE ARTIST
      </a>
    )}
  </section>
</Layout>
