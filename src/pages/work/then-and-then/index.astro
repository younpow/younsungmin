---
import Layout from "../../../layouts/Layout.astro";
import interactive from "../../../content/then-and-then.json";
---

<Layout
  title="THEN AND THEN — THE THICKNESS OF TIME | YOUN SUNGMIN"
  description="An interactive photographic artwork by Youn Sungmin. Explore fourteen photographs of one room through overlapping, sliced and depth-shifted views."
  image={interactive.image}
>
  <article class="interactive-page">
    <header class="project-intro">
      <h1>{interactive.title}</h1>
      <p class="chapter">{interactive.subtitle}</p>
      <p class="project-completion">
        <span data-lang="en">
          Interactive photographic artwork · {interactive.year}
        </span>
        <span data-lang="ko" lang="ko">
          인터랙티브 사진 작품 · {interactive.year}
        </span>
      </p>
      <div class="prose statement">
        <p data-lang="en" lang="en">
          {interactive.description.en}
        </p>
        <p data-lang="ko" lang="ko">
          {interactive.description.ko}
        </p>
      </div>
      <a
        class="text-link"
        href={interactive.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-lang="en">EXPERIENCE THE WORK ↗</span>
        <span data-lang="ko" lang="ko">
          작품 체험하기 ↗
        </span>
      </a>
      <p class="interactive-instructions">
        <span data-lang="en">
          In a modern browser, select ENTER THE ROOM, then use VIEW, CHOOSE
          MOMENTS and WATCH. Sound is optional; headphones are recommended.
        </span>
        <span data-lang="ko" lang="ko">
          최신 브라우저에서 ENTER THE ROOM을 선택한 뒤 VIEW, CHOOSE MOMENTS,
          WATCH를 이용할 수 있다. 소리는 선택 사항이며 헤드폰 사용을 권장한다.
        </span>
      </p>
    </header>
    <img
      class="interactive-preview artwork"
      src={interactive.image}
      width={interactive.imageWidth}
      height={interactive.imageHeight}
      alt={interactive.imageAlt.en}
      data-alt-en={interactive.imageAlt.en}
      data-alt-ko={interactive.imageAlt.ko}
      loading="eager"
      decoding="async"
      draggable="false"
    />
    <a class="text-link back" href="/work/">
      <span data-lang="en">BACK TO WORK</span>
      <span data-lang="ko" lang="ko">
        작품 목록으로
      </span>
    </a>
  </article>
</Layout>
