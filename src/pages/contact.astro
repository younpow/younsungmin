---
import Layout from "../layouts/Layout.astro";
import site from "../config/site.json";
---

<Layout
  title="Contact | YOUN SUNGMIN"
  description="Contact photographer Youn Sungmin, based in South Korea."
  image="/media/home/ourtime_2026-03-08_01.jpg"
>
  <section class="text-page contact">
    <h1>CONTACT</h1>
    <a href={"mailto:" + site.email}>{site.email}</a>
    <div class="contact-links">
      <a
        href="https://www.instagram.com/younsungmin_photo/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-lang="en">Instagram</span>
        <span data-lang="ko" lang="ko">
          인스타그램
        </span>
        <span aria-hidden="true"> ↗</span>
      </a>
      <a
        href="https://danbit.gallery"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-lang="en">Danbit — youth photography project</span>
        <span data-lang="ko" lang="ko">
          단빛 — 청소년 사진 프로젝트
        </span>
        <span aria-hidden="true"> ↗</span>
      </a>
    </div>
  </section>
</Layout>
